{
  "name": "dsh-aupdate",
  "version": "0.7.5",
  "type": "module",
  "description": "定时检查 DSH 插件更新，串行安装后就地生效，不重启；支持多种调度节奏、失败抑制、按包回滚，并在动手前留快照、忙时自动让开；不更新/只更新哪些插件改成勾选，发现更新在右下角提醒，日志最新在最上面，并在「设置 → 插件更新」里有独立一页。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CalmSun/dsh-aupdate.git"
  },
  "bugs": {
    "url": "https://github.com/CalmSun/dsh-aupdate/issues"
  },
  "homepage": "https://github.com/CalmSun/dsh-aupdate#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.1"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "auto-update"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
